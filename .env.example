# Copy this file to .env and fill in the values
# cp .env.example .env

# Your Airflow user ID (Linux users: run `id -u` to get this)
AIRFLOW_UID=50000

# Google Cloud project settings
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-crypto-pipeline-bucket

# Optional: path to your GCP service account key JSON
# GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/config/gcp-key.json
